# Supabase (obligatorio para multi-usuario)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Analytics (opcional)
VITE_PLAUSIBLE_DOMAIN=parchatebogota.app
VITE_MIXPANEL_TOKEN=mp_...

# Observabilidad (opcional)
VITE_SENTRY_DSN=

# Admin PIN solo modo demo local (sin Supabase). En producción usa is_admin en DB.
VITE_ADMIN_PIN=cambia_este_pin_largo

# Deep links / URL pública
VITE_APP_URL=https://parchatebogota.app

# KYC identidad (cédula) — requiere proveedor + Edge Function kyc-webhook
# VITE_KYC_ENABLED=true
# VITE_KYC_PROVIDER=truora
